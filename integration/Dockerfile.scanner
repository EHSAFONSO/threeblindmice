FROM python:3.12-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b
WORKDIR /app
ENV PIP_CONFIG_FILE=/app/requirements/pip.conf
COPY requirements ./requirements
RUN PIP_CONFIG_FILE=/dev/null pip install --no-cache-dir --require-hashes --only-binary :all: --no-deps \
        -r requirements/bootstrap.txt \
    && pip install --no-cache-dir --require-hashes --no-build-isolation -r requirements/dev.txt
COPY pyproject.toml README.md ./
COPY src ./src
COPY tests ./tests
RUN pip install --no-cache-dir --no-deps --no-build-isolation -e .
# A prontidão dos serviços é garantida pelos healthchecks do compose.yml.
CMD ["pytest", "-m", "integration", "-v", "tests/integration"]
