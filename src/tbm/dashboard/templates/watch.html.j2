{% extends "base.html.j2" %}
{% block title %}Vigia · threeblindmice{% endblock %}
{% block content %}
<style>
  .grid2 { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; }
  .grid2 > div { border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px; }
  .big { font-size: 20px; font-weight: 700; }
  pre.log { background: var(--bg); border: 1px solid var(--line); border-radius: 8px; padding: 10px; max-height: 320px;
            overflow: auto; font-size: 12px; white-space: pre-wrap; }
  label.field { display: block; font-weight: 600; margin: 12px 0 4px; }
</style>

<section style="margin-top:18px">
  <h2>Vigia automático · {{ label }}</h2>
  <p class="hint">O vigia roda um scan sozinho de tempos em tempos, pelo agendador do sistema
    ({{ "Agendador de Tarefas do Windows, sem abrir janela" if platform == "win32" else "systemd ou cron" }}),
    e avisa você só quando aparece algo inédito. O computador precisa estar ligado nos horários.</p>

  <div class="grid2">
    <div><span class="label">Situação</span><br>
      {% if not st.supported %}<span class="big">—</span><br><span class="hint">use o cron (veja abaixo)</span>
      {% elif st.installed %}<span class="big ok">Ativo</span>{% if st.state %}<br><span class="hint">{{ st.state }}</span>{% endif %}
      {% else %}<span class="big">Desligado</span>{% endif %}</div>
    <div><span class="label">Próxima execução</span><br><span class="big">{{ st.next.strftime("%d/%m %H:%M") if st.next else "—" }}</span></div>
    <div><span class="label">Última execução</span><br><span class="big">{{ st.last.strftime("%d/%m %H:%M") if st.last else "—" }}</span>
      {% if st.result is not none and st.last %}<br><span class="hint">{{ "concluída" if st.result in (0, 1) else "código " ~ st.result }}</span>{% endif %}</div>
    <div><span class="label">Último scan no histórico</span><br>
      <span class="big">{{ last.started_at.astimezone().strftime("%d/%m %H:%M") if last else "—" }}</span>
      {% if last %}<br><span class="hint">nota {{ last.grade }} {{ last.score }}/100</span>{% endif %}</div>
    <div><span class="label">Alertas</span><br><span class="big">{{ "Ligados" if notify.kind != "none" else "Desligados" }}</span>
      <br><a href="/alerts" class="hint">{{ notify.label if notify.kind != "none" else "configurar →" }}</a></div>
  </div>

  {% if st.installed %}
  <p style="margin-top:14px">
    {% if platform == "win32" %}<button class="btn ghost" id="run-now">Executar agora</button>{% endif %}
    <button class="btn ghost" id="remove">Desligar vigia</button>
    <span id="msg-top" class="hint"></span>
  </p>
  {% endif %}
</section>

<section>
  <h2>{{ "Alterar o vigia" if st.installed else "Ligar o vigia" }}</h2>
  {% if notify.kind == "none" %}<p class="error" style="font-weight:400">Os alertas estão desligados: o vigia vai escanear,
    mas não vai avisar você. <a href="/alerts">Configure os alertas</a> primeiro.</p>{% endif %}
  <label class="field" for="targets">O que vigiar</label>
  <input type="text" id="targets" value="{{ suggested }}" size="30">
  <label class="field" for="label">Nome do histórico</label>
  <input type="text" id="label" value="{{ label }}" size="20">
  <label class="field" for="hours">Frequência</label>
  <select id="hours">
    <option value="1">a cada 1 hora</option><option value="3">a cada 3 horas</option>
    <option value="6" selected>a cada 6 horas (recomendado)</option>
    <option value="12">a cada 12 horas</option><option value="24">uma vez por dia</option>
  </select>
  <p><label><input type="checkbox" id="udp" checked> testar serviços UDP</label>
     <label style="margin-left:14px"><input type="checkbox" id="gentle"> modo cuidadoso</label></p>
  <p class="hint">Os testes ativos ficam sempre de fora do vigia, para ele não gerar tentativas de login nos aparelhos
    a cada poucas horas.</p>
  <button class="btn" id="install">{{ "Salvar alterações" if st.installed else "Ligar vigia" }}</button>
  <span id="msg" class="hint"></span>
  <pre id="manual" class="log" hidden></pre>
</section>

{% if log %}
<section>
  <h2>Saída das últimas execuções</h2>
  <pre class="log">{{ log }}</pre>
</section>
{% endif %}

<script>
const $ = id => document.getElementById(id);
const label = {{ label | tojson }};
function say(el, text, ok) { el.textContent = text; el.className = ok === undefined ? "hint" : (ok ? "ok" : "error"); }

$("install").addEventListener("click", async () => {
  $("install").disabled = true; say($("msg"), "Configurando o agendador…");
  try {
    const r = await tbmPost("/api/watch/install", {targets: $("targets").value, label: $("label").value,
      hours: +$("hours").value, udp: $("udp").checked, gentle: $("gentle").checked});
    if (r.manual) { $("manual").hidden = false; $("manual").textContent = r.manual; say($("msg"), "Neste sistema, adicione manualmente:"); }
    else { say($("msg"), "Vigia ligado: " + r.description + ". " + (r.warnings || []).join(" "), true);
           setTimeout(() => location.href = "/watch?label=" + encodeURIComponent($("label").value), 1500); }
  } catch (e) { say($("msg"), e.message, false); }
  $("install").disabled = false;
});
$("remove")?.addEventListener("click", async () => {
  if (!confirm("Desligar o vigia? Os scans automáticos param.")) return;
  try { await tbmPost("/api/watch/remove", {label}); location.reload(); }
  catch (e) { say($("msg-top"), e.message, false); }
});
$("run-now")?.addEventListener("click", async () => {
  try { await tbmPost("/api/watch/run-now", {label});
        say($("msg-top"), "Iniciado em segundo plano. Recarregue em ~30s para ver o resultado.", true); }
  catch (e) { say($("msg-top"), e.message, false); }
});
</script>
{% endblock %}
