{% extends "base.html.j2" %}
{% block title %}{{ _("Visão geral") }} · threeblindmice{% endblock %}
{% block content %}
{% if not h %}
  <div class="card empty">
    {% set sniff = True %}{% include "_mascot.svg.j2" %}
    <h2 style="margin-top:10px">{{ _("Nenhum scan no histórico ainda") }}</h2>
    <p>{{ _("Rode") }} <code>tbm scan 192.168.0.0/24 --label casa</code> {{ _("ou abra a interface com") }} <code>tbm gui</code>.</p>
  </div>
{% else %}
{% set s = h.scan %}
<div id="celebrate-slot" data-scan="{{ s.scan_id }}" data-delta="{{ h.delta or 0 }}" data-grade="{{ s.grade }}"
     data-text="{{ _('Sua nota subiu {d} pontos desde o último scan!', d=h.delta or 0) }}"></div>
<div class="grid main reveal">
  <section class="card hero glow-{{ s.grade }}" aria-labelledby="saude">
    <div class="row" style="align-items:center;gap:28px">
      <div class="gauge" role="img" aria-label="{{ _('Nota {g}, {s} de 100', g=s.grade, s=s.score) }}">
        <svg viewBox="0 0 180 180" aria-hidden="true">
          <circle class="track" cx="90" cy="90" r="{{ h.gauge.r }}" fill="none" stroke-width="14"/>
          <circle class="value" cx="90" cy="90" r="{{ h.gauge.r }}" fill="none" stroke-width="14"
                  stroke-linecap="round" style="stroke-dasharray:{{ h.gauge.c }};stroke-dashoffset:{{ h.gauge.c }}"
                  data-offset="{{ h.gauge.offset }}"/>
        </svg>
        <div class="center"><span class="grade">{{ s.grade }}</span><span class="score"><span data-count="{{ s.score }}">{{ s.score }}</span>/100</span></div>
      </div>
      <div style="flex:1;min-width:240px">
        <h1 id="saude">{{ _("Saúde da rede") }} · {{ h.label }}</h1>
        <p class="muted" style="margin:6px 0 12px">
          {% if s.grade in ("A", "B") %}{{ _("Sua rede está em boa forma.") }}{% elif s.grade == "C" %}{{ _("Há pontos de atenção, mas nada grave.") }}
          {% else %}{{ _("Há problemas que merecem atenção. Comece pelas ações abaixo.") }}{% endif %}
        </p>
        <div class="row">
          {% if h.delta %}<span class="pill trend {{ 'up' if h.delta > 0 else 'down' }}">
            <svg class="icon" aria-hidden="true"><use href="#i-{{ 'up' if h.delta > 0 else 'down' }}"/></svg>
            {{ _("{d} desde o scan anterior", d="%+d" | format(h.delta)) }}</span>{% endif %}
          {% for sev in ["critical", "high", "medium", "low"] %}{% if h.open_counts[sev] %}
          <a class="badge sev-{{ sev }}" href="/findings/{{ h.label | urlencode }}?min={{ sev }}">{{ h.open_counts[sev] }} {{ sev | sev }}</a>
          {% endif %}{% endfor %}
          {% if not h.open_counts.values() | select | list %}<span class="badge sev-ok">{{ _("nenhum achado aberto") }}</span>{% endif %}
        </div>
        {% set sp = mini_path(h.scores[-20:], 520, 70) %}
        <svg class="spark-big" viewBox="0 0 {{ sp.w }} {{ sp.h }}" preserveAspectRatio="none" role="img"
             aria-label="{{ _('Evolução da nota de {l}', l=h.label) }}" style="margin-top:14px">
          <path class="a" d="{{ sp.area }}"/><path class="l" d="{{ sp.line }}" vector-effect="non-scaling-stroke"/>
        </svg>
      </div>
    </div>
    {% if h.projection and h.projection.gain > 0 %}
    <div class="forecast">
      <svg class="icon lg" aria-hidden="true"><use href="#i-sparkle"/></svg>
      <div style="flex:1;min-width:200px"><b>{{ _("Fazendo as {n} primeiras ações, sua nota vai para {g}", n=[h.actions | length, 3] | min, g=h.projection.grade) }}</b>
        <div class="hint">{{ _("de {a} para {b} pontos", a=s.score, b=h.projection.score) }}</div></div>
      <span class="grades"><span class="grade-{{ s.grade }}">{{ s.grade }}</span>→<span class="grade-{{ h.projection.grade }}">{{ h.projection.grade }}</span></span>
    </div>
    {% endif %}
  </section>

  <section class="card" aria-labelledby="status">
    <h2 id="status">{{ _("Situação") }}</h2>
    <div class="kpis" style="margin-top:4px">
      <a class="kpi" href="/inventory/{{ h.label | urlencode }}" style="text-decoration:none;color:inherit">
        <div class="label">{{ _("Aparelhos") }}</div><div class="value" data-count="{{ h.devices }}">{{ h.devices }}</div>
        <div class="sub">{% if h.unknown %}<span style="color:var(--high)">{{ _("{n} não aprovado(s)", n=h.unknown) }}</span>{% else %}{{ _("todos aprovados") }}{% endif %}</div></a>
      <div class="kpi"><div class="label">{{ _("Resolvidos") }}</div>
        <div class="value"><span data-count="{{ h.progress.resolved }}">{{ h.progress.resolved }}</span><span class="hint" style="font-size:14px">/{{ h.progress.total }}</span></div>
        <div class="progress" style="height:6px;margin-top:8px" role="progressbar" aria-valuenow="{{ h.progress.percent }}" aria-valuemin="0" aria-valuemax="100"
             aria-label="{{ _('Progresso das correções') }}"><div style="width:{{ h.progress.percent }}%"></div></div></div>
    </div>
    <div class="stack" style="margin-top:16px">
      <div class="row"><svg class="icon" aria-hidden="true"><use href="#i-clock"/></svg>{{ _("Último scan {age}", age=h.age) }}
        <span class="spacer"></span><a href="/scan/{{ s.scan_id }}" class="hint">{{ _("relatório") }}</a></div>
      {% if gui %}
      <div class="row" data-get="/partials/status" data-trigger="load"><div class="skeleton line" style="width:100%"></div></div>
      {% endif %}
      {% if h.progress.accepted %}<p class="hint" style="margin:0">{{ _("{n} risco(s) aceito(s) fora da conta.", n=h.progress.accepted) }}</p>{% endif %}
    </div>
  </section>
</div>

<h2 class="section-title"><svg class="icon" aria-hidden="true"><use href="#i-tool"/></svg>{{ _("O que fazer agora") }}</h2>
{% if h.actions %}
  <div class="reveal">
  {% for a in h.actions[:3] %}
  <article class="action sev-bar {{ a.severity.value }}">
    <span class="num" aria-hidden="true">{{ loop.index }}</span>
    <div style="flex:1">
      <h3>{{ action_title(a) }}</h3>
      <div class="hint">{{ _(a.why) }}</div>
      <div class="row" style="margin-top:8px">
        <span class="badge sev-{{ a.severity.value }}">{{ a.severity | sev }}</span>
        <span class="hint">{{ _("resolve {n} achado(s)", n=a.findings | length) }}</span>
        {% if h.impact.get(a.key, 0) > 0 %}<span class="impact">+{{ h.impact[a.key] }} {{ _("pontos") }}</span>{% endif %}
        {% if a.kev %}<span class="badge sev-critical tech">{{ _("explorada ativamente") }}</span>
        {% elif a.max_epss and a.max_epss >= 0.1 %}<span class="badge sev-high tech">EPSS {{ "%.0f" | format(a.max_epss * 100) }}%</span>{% endif %}
        <span class="spacer"></span>
        {% if gui and a.letter_url(h.label) %}<a class="btn sm ghost" href="{{ a.letter_url(h.label) }}"><svg class="icon" aria-hidden="true"><use href="#i-mail"/></svg>{{ _("Carta para o provedor") }}</a>{% endif %}
        {% if gui %}<a class="btn sm" href="/fix/{{ h.label | urlencode }}/{{ a.key }}"><svg class="icon" aria-hidden="true"><use href="#i-wrench"/></svg>{{ _("Corrigir agora") }}</a>
        {% else %}<a class="btn sm subtle" href="/findings/{{ h.label | urlencode }}#a-{{ a.key }}">{{ _("Detalhes") }}</a>{% endif %}
      </div>
    </div>
  </article>
  {% endfor %}
  </div>
  {% if h.actions | length > 3 %}<p><a href="/findings/{{ h.label | urlencode }}">{{ _("Ver todas as {n} ações →", n=h.actions | length) }}</a></p>{% endif %}
{% else %}
  <div class="card empty">{% set sniff = False %}{% include "_mascot.svg.j2" %}
    <p>{{ _("Nada a fazer agora. Os próximos scans avisam se algo mudar.") }}</p></div>
{% endif %}

<h2 class="section-title"><svg class="icon" aria-hidden="true"><use href="#i-up"/></svg>{{ _("Evolução") }}</h2>
{% if h.labels | length > 1 %}
<div class="chips" style="margin-bottom:10px">
  {% for lb in h.labels %}<a class="pill" href="/?label={{ lb | urlencode }}"{% if lb == h.label %} aria-current="page"{% endif %}>{{ lb }}</a>{% endfor %}
</div>
{% endif %}
<div id="panel" data-get="/partials/label/{{ h.label | urlencode }}" data-trigger="load"><div class="skeleton block"></div></div>
{% endif %}
{% endblock %}
