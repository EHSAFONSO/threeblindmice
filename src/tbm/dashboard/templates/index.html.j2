{% extends "base.html.j2" %}
{% block content %}
  {% if not labels %}
  <section style="margin-top:22px">
    {% if gui %}<h2>Bem-vindo!</h2><p>Nenhum scan ainda. Comece descobrindo o que há na sua rede.</p>
      <p><a class="btn" href="/scan">Fazer o primeiro scan</a> <a class="btn ghost" href="/features">Ver o que o programa faz</a></p>
    {% else %}<p>Nenhum scan no histórico ainda. Rode <code>tbm scan 192.168.0.0/24 --label casa</code>.</p>{% endif %}
  </section>
  {% else %}
  <div class="cards">
    {% for r in labels %}
    <div class="card" data-get="/partials/label/{{ r.label | urlencode }}" data-target="#panel"
         onclick="document.querySelectorAll('.card').forEach(c=>c.classList.remove('active'));this.classList.add('active')">
      <div class="top">
        <b>{{ r.label }}</b>
        <span class="grade grade-{{ r.grade }}">{{ r.grade }}</span>
      </div>
      <div class="muted">{{ r.score }}/100 · {{ r.hosts }} hosts · {{ r.total }} scans</div>
      <div class="pills">
        {% if r.critical %}<span class="c">{{ r.critical }} critical</span>{% endif %}
        {% if r.high %}<span class="h">{{ r.high }} high</span>{% endif %}
        {% if r.medium %}<span class="m">{{ r.medium }} medium</span>{% endif %}
        {% if r.low %}<span class="l">{{ r.low }} low</span>{% endif %}
      </div>
      {{ sparks[r.label] | safe }}
      <div class="muted" style="font-size:12px">último: {{ r.started_at | when }}</div>
    </div>
    {% endfor %}
  </div>
  <div id="panel" data-get="/partials/label/{{ labels[0].label | urlencode }}" data-trigger="load">
    <section class="muted">Carregando…</section>
  </div>
  {% endif %}
{% endblock %}
