{% extends "base.html.j2" %}
{% block title %}{{ _("Visão geral") }} · threeblindmice{% endblock %}
{% block content %}
{% if not h %}
  <div class="card empty">
    <svg class="icon xl" aria-hidden="true"><use href="#i-radar"/></svg>
    <h2 style="margin-top:10px">{{ _("Nenhum scan no histórico ainda") }}</h2>
    <p>{{ _("Rode") }} <code>tbm scan 192.168.0.0/24 --label casa</code> {{ _("ou abra a interface com") }} <code>tbm gui</code>.</p>
  </div>
{% else %}
{% set s = h.scan %}
<div class="grid main">
  <section class="card" aria-labelledby="saude">
    <div class="row" style="align-items:center;gap:26px">
      <div class="gauge" role="img" aria-label="{{ _("Nota {g}, {s} de 100", g=s.grade, s=s.score) }}">
        <svg viewBox="0 0 180 180" aria-hidden="true">
          <circle class="track" cx="90" cy="90" r="{{ h.gauge.r }}" fill="none" stroke-width="14"/>
          <circle class="value grade-stroke-{{ s.grade }}" cx="90" cy="90" r="{{ h.gauge.r }}" fill="none" stroke-width="14"
                  stroke-linecap="round" stroke="currentColor" style="stroke-dasharray:{{ h.gauge.c }};stroke-dashoffset:{{ h.gauge.c }}"
                  data-offset="{{ h.gauge.offset }}"/>
        </svg>
        <div class="center"><span class="grade grade-{{ s.grade }}">{{ s.grade }}</span><span class="score">{{ s.score }}/100</span></div>
      </div>
      <div style="flex:1;min-width:220px">
        <h1 id="saude" style="font-size:22px">{{ _("Saúde da rede") }} · {{ h.label }}</h1>
        <p class="muted" style="margin:6px 0 12px">
          {% if s.grade in ("A", "B") %}{{ _("Sua rede está em boa forma.") }}{% elif s.grade == "C" %}{{ _("Há pontos de atenção, mas nada grave.") }}
          {% else %}{{ _("Há problemas que merecem atenção. Comece pelas ações abaixo.") }}{% endif %}
        </p>
        <div class="row">
          {% if h.delta %}<span class="pill trend {{ 'up' if h.delta > 0 else 'down' }}">
            <svg class="icon" aria-hidden="true"><use href="#i-{{ 'up' if h.delta > 0 else 'down' }}"/></svg>
            {{ _("{d} desde o scan anterior", d="%+d" | format(h.delta)) }}</span>{% endif %}
          {{ sparks.get(h.label, "") | safe }}
        </div>
        <div class="row" style="margin-top:12px">
          {% for sev in ["critical", "high", "medium", "low"] %}{% if h.open_counts[sev] %}
          <a class="badge sev-{{ sev }}" href="/findings/{{ h.label | urlencode }}?min={{ sev }}">{{ h.open_counts[sev] }} {{ sev }}</a>
          {% endif %}{% endfor %}
          {% if not h.open_counts.values() | select | list %}<span class="badge sev-ok">{{ _("nenhum achado aberto") }}</span>{% endif %}
        </div>
      </div>
    </div>
  </section>

  <section class="card" aria-labelledby="status">
    <h2 id="status">{{ _("Situação") }}</h2>
    <div class="stack">
      <div class="row"><svg class="icon" aria-hidden="true"><use href="#i-clock"/></svg>{{ _("Último scan {age}", age=h.age) }}
        <span class="spacer"></span><a href="/scan/{{ s.scan_id }}" class="hint">{{ _("relatório") }}</a></div>
      <div class="row"><svg class="icon" aria-hidden="true"><use href="#i-grid"/></svg>{{ _("{n} dispositivo(s)", n=h.devices) }}
        <span class="spacer"></span><a href="/map/{{ h.label | urlencode }}" class="hint">{{ _("ver no mapa") }}</a></div>
      {% if gui %}
      <div class="row" data-get="/partials/status" data-trigger="load"><span class="muted">{{ _("Carregando vigia e alertas…") }}</span></div>
      {% endif %}
      <div>
        <div class="row hint" style="margin-bottom:6px"><span>{{ _("Progresso das correções") }}</span><span class="spacer"></span>
          <b>{{ _("{a} de {b}", a=h.progress.resolved, b=h.progress.total) }}</b>&nbsp;{{ _("resolvidos") }}</div>
        <div class="progress" role="progressbar" aria-valuenow="{{ h.progress.percent }}" aria-valuemin="0" aria-valuemax="100"
             aria-label="{{ _("Progresso das correções") }}"><div style="width:{{ h.progress.percent }}%"></div></div>
        {% if h.progress.accepted %}<p class="hint" style="margin:6px 0 0">{{ _("{n} risco(s) aceito(s) fora da conta.", n=h.progress.accepted) }}</p>{% endif %}
      </div>
    </div>
  </section>
</div>

<h2 class="section-title"><svg class="icon" aria-hidden="true"><use href="#i-tool"/></svg>{{ _("O que fazer agora") }}</h2>
{% if h.actions %}
  {% for a in h.actions[:3] %}
  <article class="action sev-bar {{ a.severity.value }}">
    <span class="num" aria-hidden="true">{{ loop.index }}</span>
    <div style="flex:1">
      <h3>{{ action_title(a) }}</h3>
      <div class="hint">{{ _(a.why) }}</div>
      <div class="row" style="margin-top:8px">
        <span class="badge sev-{{ a.severity.value }}">{{ a.severity.value }}</span>
        <span class="hint">{{ _("resolve {n} achado(s)", n=a.findings | length) }}</span>
        {% if a.kev %}<span class="badge sev-critical">{{ _("explorada ativamente") }}</span>
        {% elif a.max_epss and a.max_epss >= 0.1 %}<span class="badge sev-high">EPSS {{ "%.0f" | format(a.max_epss * 100) }}%</span>{% endif %}
        <span class="spacer"></span>
        {% if gui and a.letter_url(h.label) %}<a class="btn sm ghost" href="{{ a.letter_url(h.label) }}"><svg class="icon" aria-hidden="true"><use href="#i-mail"/></svg>{{ _("Carta para o provedor") }}</a>{% endif %}
        <a class="btn sm subtle" href="/findings/{{ h.label | urlencode }}#a-{{ a.key }}">{{ _("Detalhes") }}</a>
      </div>
    </div>
  </article>
  {% endfor %}
  {% if h.actions | length > 3 %}<p><a href="/findings/{{ h.label | urlencode }}">{{ _("Ver todas as {n} ações →", n=h.actions | length) }}</a></p>{% endif %}
{% else %}
  <div class="card empty"><svg class="icon xl" aria-hidden="true"><use href="#i-shield-check"/></svg>
    <p>{{ _("Nada a fazer agora. Os próximos scans avisam se algo mudar.") }}</p></div>
{% endif %}

<h2 class="section-title"><svg class="icon" aria-hidden="true"><use href="#i-up"/></svg>{{ _("Evolução") }}</h2>
{% if h.labels | length > 1 %}
<div class="row" style="margin-bottom:10px">
  {% for lb in h.labels %}<a class="pill" href="/?label={{ lb | urlencode }}"{% if lb == h.label %} aria-current="page"{% endif %}>{{ lb }}</a>{% endfor %}
</div>
{% endif %}
<div id="panel" data-get="/partials/label/{{ h.label | urlencode }}" data-trigger="load"><div class="card muted">{{ _("Carregando…") }}</div></div>
{% endif %}
<style>.grade-stroke-A, .grade-stroke-B { color: var(--good); } .grade-stroke-C { color: var(--medium); }
.grade-stroke-D { color: var(--high); } .grade-stroke-F { color: var(--critical); }</style>
{% endblock %}
