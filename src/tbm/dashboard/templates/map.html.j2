{% extends "base.html.j2" %}
{% block title %}Mapa da rede · {{ label }}{% endblock %}
{% block content %}
<div class="row" style="margin-bottom:12px">
  <h1 style="font-size:22px">Mapa da rede · {{ label }}</h1><span class="spacer"></span>
  <span class="hint">scan de {{ scan.started_at.astimezone().strftime("%d/%m %H:%M") }} · clique num aparelho para ver os detalhes</span>
</div>
{% for n in m.notes %}<div class="banner warn" style="margin-bottom:10px"><svg class="icon" aria-hidden="true"><use href="#i-alert"/></svg><div>{{ n }}</div></div>{% endfor %}
<div class="card" style="padding:12px">
  <svg class="netmap" viewBox="0 0 {{ m.width }} {{ m.height }}" role="img" aria-label="Mapa com {{ m.nodes | length - 1 }} dispositivos">
    {% for e in m.edges %}<line x1="{{ e.x1 }}" y1="{{ e.y1 }}" x2="{{ e.x2 }}" y2="{{ e.y2 }}" class="edge{% if e.dashed %} dashed{% endif %}"/>{% endfor %}
    {% for n in m.nodes %}
    <g class="node" transform="translate({{ n.x }},{{ n.y }})"
       {% if n.address %}tabindex="0" role="button" aria-label="{{ n.label }}, {{ n.sub }}"
       data-drawer="/partials/device/{{ label | urlencode }}/{{ n.address }}" data-tip="{{ n.tip }}"{% endif %}>
      <circle class="bg ring-{{ n.sev }}" r="{{ 36 if n.role in ('gateway', 'router') or not n.address else 30 }}"/>
      <svg x="-14" y="-14" width="28" height="28" viewBox="0 0 24 24" class="icon"><use href="#i-{{ n.icon }}"/></svg>
      <text y="{{ 56 if n.role in ('gateway', 'router') or not n.address else 50 }}">{{ n.label }}</text>
      {% if n.sub %}<text class="sub" y="{{ 71 if n.role in ('gateway', 'router') else 65 }}">{{ n.sub }}{% if n.role == 'gateway' %} · roteador principal{% endif %}</text>{% endif %}
    </g>
    {% endfor %}
  </svg>
</div>
<div class="row" style="margin-top:12px">
  <span class="hint">Contorno = pior problema aberto:</span>
  {% for s, name in [("critical", "crítico"), ("high", "alto"), ("medium", "médio"), ("low", "baixo"), ("ok", "sem problemas")] %}
  <span class="row" style="gap:6px"><span class="dot {{ s }}"></span><span class="hint">{{ name }} ({{ m.legend[s] }})</span></span>
  {% endfor %}
</div>
{% endblock %}
