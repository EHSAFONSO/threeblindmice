{% extends "base.html.j2" %}
{% block title %}Alertas · threeblindmice{% endblock %}
{% block content %}
{% if get_lang() == "en" %}<div class="banner" style="margin-bottom:14px" role="note">This page is only available in Portuguese for now.</div>{% endif %}
<style>
  .tabs { display: flex; gap: 6px; margin: 12px 0; flex-wrap: wrap; }
  .tabs button { font: inherit; padding: 7px 14px; border-radius: 8px; border: 1px solid var(--line);
                 background: var(--panel); color: var(--text); cursor: pointer; font-weight: 600; }
  .tabs button.on { border-color: var(--accent); color: var(--accent); }
  .pane { display: none; } .pane.on { display: block; }
  .step { border-left: 3px solid var(--line); padding: 4px 0 4px 14px; margin: 14px 0; }
  .step.done { border-color: var(--good); }
  .step h3 { margin: 0 0 6px; font-size: 15px; }
  .chat { display: block; padding: 8px 10px; border: 1px solid var(--line); border-radius: 8px; margin: 6px 0; cursor: pointer; }
  .chat:has(input:checked) { border-color: var(--accent); }
  .status { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; }
  .dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
</style>

<section class="card" style="margin-top:18px">
  <h2>Alertas</h2>
  <p class="hint">O tbm avisa você quando um scan encontra algo <b>inédito</b>: um achado novo de severidade média ou
    maior, um aparelho que nunca esteve na rede, uma porta nova ou um MAC trocado. Scans sem novidade não mandam nada.</p>
  <div class="status">
    <span class="dot" style="background: {{ 'var(--good)' if current.kind != 'none' else 'var(--muted)' }}"></span>
    <b id="current-label">{{ current.label }}</b>
    {% if source == "env" %}<span class="hint">(definido pela variável TBM_WEBHOOK)</span>{% endif %}
    {% if current.kind != "none" %}
      <button class="btn ghost" id="test-current">Enviar teste</button>
      <button class="btn ghost" id="remove-current">Desativar alertas</button>
    {% endif %}
    <span id="current-msg" class="hint"></span>
  </div>
  <label class="check" style="margin-top:14px"><input type="checkbox" id="weekly" {% if weekly %}checked{% endif %}>
    <span><b>Resumo semanal</b><span class="hint">Uma vez por semana, depois de um scan, manda a nota, o que mudou e a
      próxima ação, mesmo sem novidade. Assim você sabe que o vigia continua rodando.</span></span></label>
</section>

<section class="card">
  <h2>{{ "Trocar o destino" if current.kind != "none" else "Configurar" }}</h2>
  <div class="tabs">
    <button class="on" data-tab="telegram">Telegram</button>
    <button data-tab="ntfy">ntfy (mais simples)</button>
    <button data-tab="url">Discord, Slack ou webhook</button>
  </div>

  <div class="pane on" id="pane-telegram">
    <div class="step" id="tg-step1">
      <h3>1. Crie o bot</h3>
      <p class="hint">No Telegram, abra o <b>@BotFather</b>, envie <code>/newbot</code>, escolha um nome e um username
        terminado em <code>bot</code>. Ele responde com o <b>token</b>, que funciona como uma senha.</p>
      <input type="password" id="tg-token" placeholder="Cole o token aqui" size="52" autocomplete="off">
      <button class="btn" id="tg-lookup">Continuar</button>
      <span id="tg-msg1" class="hint"></span>
    </div>
    <div class="step" id="tg-step2" hidden>
      <h3>2. Escolha a conversa</h3>
      <p class="hint" id="tg-instructions"></p>
      <div id="tg-chats"></div>
      <button class="btn ghost" id="tg-refresh">Procurar de novo</button>
    </div>
    <div class="step" id="tg-step3" hidden>
      <h3>3. Testar e salvar</h3>
      <p class="hint">Enviamos uma mensagem de teste. Se ela chegar, a configuração é salva.</p>
      <button class="btn" id="tg-save">Enviar teste e salvar</button>
      <span id="tg-msg3" class="hint"></span>
    </div>
  </div>

  <div class="pane" id="pane-ntfy">
    <p class="hint">O <b>ntfy</b> é um app gratuito de notificações, sem cadastro. Instale o app (Android ou iOS),
      toque em <b>+</b> e inscreva-se no tópico abaixo. Qualquer pessoa que souber o nome do tópico consegue ler as
      mensagens, então mantenha um nome difícil de adivinhar.</p>
    <input type="text" id="ntfy-topic" value="{{ suggested_topic }}" size="30">
    <button class="btn" id="ntfy-save">Enviar teste e salvar</button>
    <span id="ntfy-msg" class="hint"></span>
  </div>

  <div class="pane" id="pane-url">
    <p class="hint">Cole a URL do webhook do <b>Discord</b> (Configurações do canal → Integrações → Webhooks) ou do
      <b>Slack</b> (Incoming Webhooks). Qualquer outra URL https recebe um POST com o JSON completo do scan.</p>
    <input type="password" id="hook-url" placeholder="https://discord.com/api/webhooks/…" size="60" autocomplete="off">
    <button class="btn" id="hook-save">Enviar teste e salvar</button>
    <span id="hook-msg" class="hint"></span>
  </div>
</section>

<section class="card">
  <h2>Pela linha de comando</h2>
  <p class="hint">A mesma configuração vale para <code>tbm scan</code>, <code>tbm watch</code> e o vigia automático.
    Equivalentes: <code>tbm telegram-setup</code> e <code>tbm notify-test</code>.</p>
</section>

<script>
const $ = id => document.getElementById(id);
function say(el, text, ok) { el.textContent = text; el.className = ok === undefined ? "hint" : (ok ? "ok" : "error"); }

document.querySelectorAll(".tabs button").forEach(b => b.addEventListener("click", () => {
  document.querySelectorAll(".tabs button").forEach(x => x.classList.toggle("on", x === b));
  document.querySelectorAll(".pane").forEach(p => p.classList.toggle("on", p.id === "pane-" + b.dataset.tab));
}));

async function saved(res, el) {
  say(el, "Mensagem de teste enviada e configuração salva. " + (res.notes || []).join(" "), true);
  $("current-label").textContent = res.current.label;
  setTimeout(() => location.reload(), 2500);
}

// Telegram
let chosen = null;
async function lookup() {
  say($("tg-msg1"), "Conferindo com o Telegram…");
  try {
    const r = await tbmPost("/api/telegram/lookup", {token: $("tg-token").value});
    $("tg-step1").classList.add("done");
    say($("tg-msg1"), "Bot @" + r.bot + " encontrado.", true);
    $("tg-step2").hidden = false;
    $("tg-instructions").innerHTML = `Abra <a href="https://t.me/${encodeURIComponent(r.bot)}" target="_blank" rel="noopener">t.me/${r.bot}</a>
      no Telegram e toque em <b>Iniciar</b> (ou mande "oi"). Para alertas num grupo, adicione o bot ao grupo e mande uma mensagem lá.`;
    if (!r.chats.length) { $("tg-chats").innerHTML = "<p class='hint'>Nenhuma conversa ainda. Depois de tocar em Iniciar, clique em Procurar de novo.</p>"; return; }
    $("tg-chats").innerHTML = r.chats.map((c, i) => `<label class="chat"><input type="radio" name="chat" value="${c.id}" ${i ? "" : "checked"}>
      <b>${c.title.replace(/[<>&]/g, "")}</b> <span class="hint">(${c.kind}, id ${c.id})</span></label>`).join("");
    $("tg-step3").hidden = false;
  } catch (e) { say($("tg-msg1"), e.message, false); }
}
$("tg-lookup").addEventListener("click", lookup);
$("tg-refresh").addEventListener("click", lookup);
$("tg-save").addEventListener("click", async () => {
  const chat = document.querySelector("input[name=chat]:checked");
  say($("tg-msg3"), "Enviando…");
  try { saved(await tbmPost("/api/alerts/save", {kind: "telegram", token: $("tg-token").value, chat_id: chat && chat.value}), $("tg-msg3")); }
  catch (e) { say($("tg-msg3"), e.message, false); }
});

// ntfy e webhook
$("ntfy-save").addEventListener("click", async () => {
  say($("ntfy-msg"), "Enviando…");
  try { saved(await tbmPost("/api/alerts/save", {kind: "ntfy", topic: $("ntfy-topic").value}), $("ntfy-msg")); }
  catch (e) { say($("ntfy-msg"), e.message, false); }
});
$("hook-save").addEventListener("click", async () => {
  say($("hook-msg"), "Enviando…");
  try { saved(await tbmPost("/api/alerts/save", {kind: "url", url: $("hook-url").value}), $("hook-msg")); }
  catch (e) { say($("hook-msg"), e.message, false); }
});

// resumo semanal
$("weekly").addEventListener("change", async e => {
  try { await tbmPost("/api/alerts/summary", {enabled: e.target.checked});
        tbmToast(e.target.checked ? "Resumo semanal ligado" : "Resumo semanal desligado", "ok"); }
  catch (err) { e.target.checked = !e.target.checked; tbmToast(err.message, "error"); }
});

// destino atual
$("test-current")?.addEventListener("click", async () => {
  say($("current-msg"), "Enviando…");
  try { await tbmPost("/api/alerts/test", {}); say($("current-msg"), "Mensagem de teste enviada. Confira no app.", true); }
  catch (e) { say($("current-msg"), e.message, false); }
});
$("remove-current")?.addEventListener("click", async () => {
  if (!await tbmConfirm("Desativar os alertas?", "Os scans deixam de mandar avisos até você configurar de novo.", "Desativar", true)) return;
  try { const r = await tbmPost("/api/alerts/remove", {}); say($("current-msg"), "Alertas desativados. " + r.notes.join(" "), true);
        setTimeout(() => location.reload(), 2000); }
  catch (e) { say($("current-msg"), e.message, false); }
});
</script>
{% endblock %}
