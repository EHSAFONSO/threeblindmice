{% extends "base.html.j2" %}
{% block title %}{{ _("Alertas") }} · threeblindmice{% endblock %}
{% block content %}
<style>
  .tabs { display: flex; gap: 6px; margin: 12px 0 4px; flex-wrap: wrap; }
  .tabs button { font: inherit; padding: 8px 14px; border-radius: 11px; border: 1px solid var(--line);
                 background: var(--panel); color: var(--muted); cursor: pointer; font-weight: 650; }
  .tabs button.on { border-color: var(--accent); color: var(--accent); background: var(--accent-soft); }
  .pane { display: none; } .pane.on { display: block; animation: rise .3s ease both; }
  .step { border-left: 3px solid var(--line); padding: 4px 0 4px 16px; margin: 16px 0; }
  .step.done { border-color: var(--good); }
  .step h3 { margin: 0 0 6px; font-size: 15px; }
  .chat { display: block; padding: 9px 12px; border: 1px solid var(--line); border-radius: 11px; margin: 6px 0; cursor: pointer; }
  .chat:has(input:checked) { border-color: var(--accent); background: var(--accent-soft); }
</style>

<h1>{{ _("Alertas") }}</h1>
<p class="muted" style="margin:6px 0 18px">{{ _("O tbm avisa você quando um scan encontra algo inédito: um achado novo de severidade média ou maior, um aparelho que nunca esteve na rede, uma porta nova ou um MAC trocado. Scans sem novidade não mandam nada.") }}</p>

<div class="grid main reveal">
  <section class="card">
    <div class="row">
      <span class="dot {{ 'ok' if current.kind != 'none' else 'off' }}" aria-hidden="true"></span>
      <b id="current-label">{{ current.label }}</b>
      {% if source == "env" %}<span class="hint">({{ _("definido pela variável TBM_WEBHOOK") }})</span>{% endif %}
    </div>
    {% if current.kind != "none" %}
    <div class="row" style="margin-top:12px">
      <button class="btn sm" id="test-current" type="button">{{ _("Enviar teste") }}</button>
      <button class="btn sm danger" id="remove-current" type="button">{{ _("Desativar alertas") }}</button>
    </div>
    {% endif %}
    <span id="current-msg" class="hint"></span>
    <label class="check" style="margin-top:14px;border-top:1px solid var(--line)"><input type="checkbox" id="weekly" {% if weekly %}checked{% endif %}>
      <span><b>{{ _("Resumo semanal") }}</b><span class="hint">{{ _("Uma vez por semana, depois de um scan, manda a nota, o que mudou e a próxima ação, mesmo sem novidade. Assim você sabe que o vigia continua rodando.") }}</span></span></label>
    <div style="margin-top:12px">
      <b>{{ _("Horário de silêncio") }}</b>
      <p class="hint" style="margin:4px 0 8px">{{ _("Nesta faixa, só alertas críticos são enviados. Deixe em branco para receber a qualquer hora.") }}</p>
      <div class="row"><label class="hint">{{ _("das") }} <input type="time" id="quiet-start" value="{{ quiet_start }}"></label>
        <label class="hint">{{ _("às") }} <input type="time" id="quiet-end" value="{{ quiet_end }}"></label>
        <button class="btn sm subtle" id="quiet-save" type="button">{{ _("Salvar") }}</button></div>
    </div>
  </section>
  <section class="card">
    <h2>{{ _("Pela linha de comando") }}</h2>
    <p class="hint">{{ _("A mesma configuração vale para tbm scan, tbm watch e o vigia automático. Equivalentes:") }}
      <code>tbm telegram-setup</code>, <code>tbm notify-test</code>, <code>tbm summary</code>.</p>
  </section>
</div>

<section class="card" style="margin-top:16px">
  <h2>{{ _("Trocar o destino") if current.kind != "none" else _("Configurar") }}</h2>
  <div class="tabs" role="tablist">
    <button class="on" data-tab="telegram" type="button">Telegram</button>
    <button data-tab="ntfy" type="button">{{ _("ntfy (mais simples)") }}</button>
    <button data-tab="url" type="button">{{ _("Discord, Slack ou webhook") }}</button>
  </div>

  <div class="pane on" id="pane-telegram">
    <div class="step" id="tg-step1">
      <h3>{{ _("1. Crie o bot") }}</h3>
      <p class="hint">{{ _("No Telegram, abra o @BotFather, envie /newbot, escolha um nome e um username terminado em bot. Ele responde com o token, que funciona como uma senha.") }}</p>
      <div class="row"><input type="password" id="tg-token" placeholder="{{ _('Cole o token aqui') }}" size="52" autocomplete="off">
        <button class="btn" id="tg-lookup" type="button">{{ _("Continuar") }}</button></div>
      <span id="tg-msg1" class="hint"></span>
    </div>
    <div class="step" id="tg-step2" hidden>
      <h3>{{ _("2. Escolha a conversa") }}</h3>
      <p class="hint" id="tg-instructions"></p>
      <div id="tg-chats"></div>
      <button class="btn sm ghost" id="tg-refresh" type="button">{{ _("Procurar de novo") }}</button>
    </div>
    <div class="step" id="tg-step3" hidden>
      <h3>{{ _("3. Testar e salvar") }}</h3>
      <p class="hint">{{ _("Enviamos uma mensagem de teste. Se ela chegar, a configuração é salva.") }}</p>
      <button class="btn" id="tg-save" type="button">{{ _("Enviar teste e salvar") }}</button>
      <span id="tg-msg3" class="hint"></span>
    </div>
  </div>

  <div class="pane" id="pane-ntfy">
    <p class="hint">{{ _("O ntfy é um app gratuito de notificações, sem cadastro. Instale o app (Android ou iOS), toque em + e inscreva-se no tópico abaixo. Qualquer pessoa que souber o nome do tópico consegue ler as mensagens, então mantenha um nome difícil de adivinhar.") }}</p>
    <div class="row"><input type="text" id="ntfy-topic" value="{{ suggested_topic }}" size="30" aria-label="{{ _('Tópico do ntfy') }}">
      <button class="btn" id="ntfy-save" type="button">{{ _("Enviar teste e salvar") }}</button></div>
    <span id="ntfy-msg" class="hint"></span>
  </div>

  <div class="pane" id="pane-url">
    <p class="hint">{{ _("Cole a URL do webhook do Discord (Configurações do canal → Integrações → Webhooks) ou do Slack (Incoming Webhooks). Qualquer outra URL https recebe um POST com o JSON completo do scan.") }}</p>
    <details class="guide" style="margin-bottom:12px"><summary>{{ _("Outros destinos (e-mail, Pushover, Home Assistant)") }}</summary>
      <ul class="hint" style="line-height:1.7">
        <li><b>E-mail</b>: <code>smtp://usuario:senha@servidor:587/destino@exemplo.com</code></li>
        <li><b>Pushover</b>: <code>pushover://&lt;app_token&gt;@&lt;user_key&gt;</code></li>
        <li><b>Home Assistant</b>: <code>hass://seu-ha:8123/&lt;webhook_id&gt;</code></li>
      </ul></details>
    <div class="row"><input type="password" id="hook-url" placeholder="https://discord.com/api/webhooks/…" size="60" autocomplete="off" aria-label="URL">
      <button class="btn" id="hook-save" type="button">{{ _("Enviar teste e salvar") }}</button></div>
    <span id="hook-msg" class="hint"></span>
  </div>
</section>

<script>
const $ = id => document.getElementById(id);
const T = {{ {"saved": _("Mensagem de teste enviada e configuração salva."), "checking": _("Conferindo com o Telegram…"),
             "found": _("Bot @{b} encontrado."), "open": _("Abra {link} no Telegram e toque em Iniciar (ou mande oi). Para alertas num grupo, adicione o bot ao grupo e mande uma mensagem lá."),
             "nochats": _("Nenhuma conversa ainda. Depois de tocar em Iniciar, clique em Procurar de novo."), "sending": _("Enviando…"),
             "weeklyOn": _("Resumo semanal ligado"), "weeklyOff": _("Resumo semanal desligado"),
             "testSent": _("Mensagem de teste enviada. Confira no app."), "offTitle": _("Desativar os alertas?"),
             "offText": _("Os scans deixam de mandar avisos até você configurar de novo."), "off": _("Desativar"),
             "offDone": _("Alertas desativados.")} | tojson }};
function say(el, text, ok) { el.textContent = text; el.className = ok === undefined ? "hint" : (ok ? "ok" : "error"); }

document.querySelectorAll(".tabs button").forEach(b => b.addEventListener("click", () => {
  document.querySelectorAll(".tabs button").forEach(x => x.classList.toggle("on", x === b));
  document.querySelectorAll(".pane").forEach(p => p.classList.toggle("on", p.id === "pane-" + b.dataset.tab));
}));

async function saved(res, el) {
  say(el, T.saved + " " + (res.notes || []).join(" "), true);
  $("current-label").textContent = res.current.label;
  setTimeout(() => location.reload(), 2500);
}

// Telegram
async function lookup() {
  say($("tg-msg1"), T.checking);
  try {
    const r = await tbmPost("/api/telegram/lookup", {token: $("tg-token").value});
    $("tg-step1").classList.add("done");
    say($("tg-msg1"), T.found.replace("{b}", r.bot), true);
    $("tg-step2").hidden = false;
    const link = document.createElement("a");
    link.href = "https://t.me/" + encodeURIComponent(r.bot); link.target = "_blank"; link.rel = "noopener"; link.textContent = "t.me/" + r.bot;
    const [before, after] = T.open.split("{link}");
    $("tg-instructions").replaceChildren(before, link, after);
    if (!r.chats.length) { const p = document.createElement("p"); p.className = "hint"; p.textContent = T.nochats; $("tg-chats").replaceChildren(p); return; }
    $("tg-chats").replaceChildren(...r.chats.map((c, i) => {
      const l = document.createElement("label"); l.className = "chat";
      l.innerHTML = '<input type="radio" name="chat"> <b></b> <span class="hint"></span>';
      l.querySelector("input").value = c.id; l.querySelector("input").checked = !i;
      l.querySelector("b").textContent = c.title; l.querySelector(".hint").textContent = `(${c.kind}, id ${c.id})`;
      return l;
    }));
    $("tg-step3").hidden = false;
  } catch (e) { say($("tg-msg1"), e.message, false); }
}
$("tg-lookup").addEventListener("click", lookup);
$("tg-refresh").addEventListener("click", lookup);
$("tg-save").addEventListener("click", async () => {
  const chat = document.querySelector("input[name=chat]:checked");
  say($("tg-msg3"), T.sending);
  try { saved(await tbmPost("/api/alerts/save", {kind: "telegram", token: $("tg-token").value, chat_id: chat && chat.value}), $("tg-msg3")); }
  catch (e) { say($("tg-msg3"), e.message, false); }
});

// ntfy e webhook
$("ntfy-save").addEventListener("click", async () => {
  say($("ntfy-msg"), T.sending);
  try { saved(await tbmPost("/api/alerts/save", {kind: "ntfy", topic: $("ntfy-topic").value}), $("ntfy-msg")); }
  catch (e) { say($("ntfy-msg"), e.message, false); }
});
$("hook-save").addEventListener("click", async () => {
  say($("hook-msg"), T.sending);
  try { saved(await tbmPost("/api/alerts/save", {kind: "url", url: $("hook-url").value}), $("hook-msg")); }
  catch (e) { say($("hook-msg"), e.message, false); }
});

// horário de silêncio
$("quiet-save").addEventListener("click", async () => {
  try { await tbmPost("/api/alerts/quiet", {start: $("quiet-start").value, end: $("quiet-end").value});
        tbmToast({{ _("Horário de silêncio salvo") | tojson }}, "ok"); }
  catch (e) { tbmToast(e.message, "error"); }
});

// resumo semanal
$("weekly").addEventListener("change", async e => {
  try { await tbmPost("/api/alerts/summary", {enabled: e.target.checked}); tbmToast(e.target.checked ? T.weeklyOn : T.weeklyOff, "ok"); }
  catch (err) { e.target.checked = !e.target.checked; tbmToast(err.message, "error"); }
});

// destino atual
$("test-current")?.addEventListener("click", async () => {
  say($("current-msg"), T.sending);
  try { await tbmPost("/api/alerts/test", {}); say($("current-msg"), T.testSent, true); }
  catch (e) { say($("current-msg"), e.message, false); }
});
$("remove-current")?.addEventListener("click", async () => {
  if (!await tbmConfirm(T.offTitle, T.offText, T.off, true)) return;
  try { const r = await tbmPost("/api/alerts/remove", {}); say($("current-msg"), T.offDone + " " + r.notes.join(" "), true);
        setTimeout(() => location.reload(), 2000); }
  catch (e) { say($("current-msg"), e.message, false); }
});
</script>
{% endblock %}
