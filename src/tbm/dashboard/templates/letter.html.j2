{% extends "base.html.j2" %}
{% block title %}{{ _("Carta para o provedor") }} · threeblindmice{% endblock %}
{% block content %}
<style>
  textarea.letter { width: 100%; min-height: 440px; font-family: var(--mono); font-size: 13px; line-height: 1.55; }
</style>

<h1>{{ _("Carta para o provedor") }}</h1>
<p class="muted" style="margin:6px 0 18px">{{ _("Muitos problemas de uma rede doméstica estão em aparelhos que você não controla, como o modem ou ONT da operadora. A saída é abrir um chamado. Esta página escreve o texto com os achados, as evidências e pedidos concretos, para você copiar e enviar pelo canal de atendimento.") }}</p>
{% if get_lang() == "en" %}<div class="banner" style="margin-bottom:14px" role="note"><svg class="icon" aria-hidden="true"><use href="#i-mail"/></svg>
  <div>{{ _("A carta é escrita em português, para provedores do Brasil.") }}</div></div>{% endif %}

<section class="card reveal">
  {% if not label %}
    <p>{{ _("Faça um scan primeiro.") }} <a href="/scan">{{ _("Novo scan") }}</a></p>
  {% elif not candidates %}
    <div class="empty">{% set sniff = False %}{% include "_mascot.svg.j2" %}
      <p class="ok">{{ _("Nenhum equipamento com achados de severidade média ou maior no último scan de {l}.", l=label) }}</p></div>
  {% else %}
  <div class="grid cols-3">
    <div><label class="field" for="lbl">{{ _("Histórico") }}</label>
      <select id="lbl" style="width:100%" onchange="location.href='/letter?label=' + encodeURIComponent(this.value)">
        {% for l in labels %}<option{% if l == label %} selected{% endif %}>{{ l }}</option>{% endfor %}
      </select></div>
    <div><label class="field" for="host">{{ _("Equipamento") }}</label>
      <select id="host" style="width:100%">
        {% for c in candidates %}<option value="{{ c.address }}"{% if c.address == selected %} selected{% endif %}>
          {{ c.label }} · {{ _("{n} achado(s)", n=c.count) }}</option>{% endfor %}
      </select></div>
    <div><label class="field" for="min">{{ _("Incluir achados a partir de") }}</label>
      <select id="min" style="width:100%"><option value="high">{{ _("alto") }}</option><option value="medium" selected>{{ _("médio") }}</option>
        <option value="low">{{ _("baixo") }}</option></select></div>
  </div>
  <label class="field" for="name">{{ _("Seu nome (para a assinatura)") }}</label>
  <input type="text" id="name" size="30" autocomplete="name">
  <div class="row" style="margin-top:14px"><button class="btn" id="gen" type="button"><svg class="icon" aria-hidden="true"><use href="#i-mail"/></svg>{{ _("Gerar carta") }}</button>
    <span id="msg" class="hint"></span></div>
  {% endif %}
</section>

<section class="card" id="out" hidden style="margin-top:16px">
  <textarea class="letter" id="text" spellcheck="true" aria-label="{{ _('Texto da carta') }}"></textarea>
  <p class="hint">{{ _("Revise e ajuste antes de enviar. O texto não é salvo em lugar nenhum.") }}</p>
  <div class="row"><button class="btn" id="copy" type="button"><svg class="icon" aria-hidden="true"><use href="#i-copy"/></svg>{{ _("Copiar") }}</button>
    <button class="btn ghost" id="download" type="button"><svg class="icon" aria-hidden="true"><use href="#i-download"/></svg>{{ _("Baixar .txt") }}</button>
    <span id="msg2" class="hint"></span></div>
</section>

<script>
const $ = id => document.getElementById(id);
const COPIED = {{ _("Copiado.") | tojson }};
$("gen")?.addEventListener("click", async () => {
  try {
    const r = await tbmPost("/api/letter", {label: {{ (label or "") | tojson }}, host: $("host").value,
                                             name: $("name").value, min_severity: $("min").value});
    $("text").value = r.text; $("out").hidden = false; $("msg").textContent = "";
    $("out").scrollIntoView({behavior: "smooth"});
  } catch (e) { $("msg").textContent = e.message; $("msg").className = "error"; }
});
$("copy").addEventListener("click", async () => {
  try { await navigator.clipboard.writeText($("text").value); tbmToast(COPIED, "ok"); }
  catch { $("text").select(); document.execCommand("copy"); tbmToast(COPIED, "ok"); }
});
$("download").addEventListener("click", () => {
  const a = document.createElement("a");
  a.href = URL.createObjectURL(new Blob([$("text").value], {type: "text/plain;charset=utf-8"}));
  a.download = "chamado-" + $("host").value + ".txt"; a.click(); URL.revokeObjectURL(a.href);
});
</script>
{% endblock %}
