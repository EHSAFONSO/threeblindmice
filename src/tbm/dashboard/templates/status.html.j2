<div class="stack" style="width:100%">
  <div class="row"><svg class="icon" aria-hidden="true"><use href="#i-eye"/></svg>
    {% if st.installed %}{{ _("Vigia ativo") }}{% if st.next %} · {{ _("próximo às {t}", t=st.next.strftime("%H:%M")) }}{% endif %}
    <span class="spacer"></span><span class="dot ok" aria-hidden="true"></span>
    {% else %}{{ _("Vigia desligado") }}<span class="spacer"></span><a class="hint" href="/watch">{{ _("ligar →") }}</a>{% endif %}
  </div>
  <div class="row"><svg class="icon" aria-hidden="true"><use href="#i-bell"/></svg>
    {% if notify.kind != "none" %}{{ _("Alertas:") }} {{ notify.label }}<span class="spacer"></span><span class="dot ok" aria-hidden="true"></span>
    {% else %}{{ _("Alertas desligados") }}<span class="spacer"></span><a class="hint" href="/alerts">{{ _("configurar →") }}</a>{% endif %}
  </div>
</div>
