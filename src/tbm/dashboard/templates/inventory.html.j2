{% extends "base.html.j2" %}
{% block title %}Dispositivos · {{ label }}{% endblock %}
{% block content %}
<div class="row" style="margin-bottom:12px">
  <h1 style="font-size:22px">Dispositivos · {{ label }}</h1><span class="spacer"></span>
  <a class="btn sm subtle" href="/map/{{ label | urlencode }}"><svg class="icon" aria-hidden="true"><use href="#i-map"/></svg>Ver no mapa</a>
</div>
<p class="hint">Último scan <code>{{ scan.scan_id }}</code> em {{ scan.started_at.astimezone().strftime("%d/%m/%Y %H:%M") }} ·
  {{ devices | length }} dispositivo(s) · histórico de {{ scans_seen }} scan(s). Cada aparelho é reconhecido pelo MAC
  (ou pelo nome anunciado), então trocar de IP não o transforma num "aparelho novo".</p>
<div class="grid cols-3" style="margin-top:12px">
  {% for d in devices %}{% set h = d.host %}
  <article class="card clickable" tabindex="0" role="button" data-drawer="/partials/device/{{ label | urlencode }}/{{ h.address }}"
           aria-label="{{ h.device_name or h.hostname or h.address }}: abrir detalhes">
    <div class="device-card">
      <span class="device-icon {{ d.sev }}"><svg class="icon lg" aria-hidden="true"><use href="#i-{{ d.icon }}"/></svg></span>
      <div style="min-width:0;flex:1">
        <b style="display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{ h.device_name or h.hostname or "Sem nome" }}</b>
        <span class="hint">{{ h.device_type or "tipo desconhecido" }}</span>
      </div>
    </div>
    <div class="row hint" style="margin-top:12px">
      <span class="mono">{{ h.address }}</span>{% if d.ips | length > 1 %}<span>(antes: {{ d.ips[:-1] | join(", ") }})</span>{% endif %}
    </div>
    {% if h.mac %}<div class="hint mono">{{ h.mac }}{% if h.vendor %} · {{ h.vendor }}{% endif %}</div>{% endif %}
    <div class="row" style="margin-top:10px">
      {% for s in ["critical", "high", "medium", "low"] %}{% if d.counts[s] %}<span class="badge sev-{{ s }}">{{ d.counts[s] }} {{ s }}</span>{% endif %}{% endfor %}
      {% if not d.total %}<span class="badge sev-ok">sem problemas</span>{% endif %}
      {% if d.accepted %}<span class="badge sev-info">{{ d.accepted }} aceito(s)</span>{% endif %}
    </div>
    <div class="row hint" style="margin-top:10px">
      <span>{{ h.services | length }} porta(s)</span><span>·</span><span>visto {{ d.times_seen }}× de {{ scans_seen }}</span>
      <span>·</span><span>desde {{ d.first_seen }}</span>
    </div>
    {% if gui and d.total %}<a class="hint" style="display:inline-block;margin-top:8px" href="/letter?label={{ label | urlencode }}&host={{ h.address | urlencode }}">carta para o provedor →</a>{% endif %}
  </article>
  {% endfor %}
</div>
{% endblock %}
