{# Os três ratos (cegos, de óculos escuros). Uso: {% include "_mascot.svg.j2" %}; com sniff=True o do meio fareja. #}
<svg class="mascot" viewBox="0 0 240 120" role="img" aria-label="{{ _('Os três ratos do threeblindmice') }}">
  {% for x, s, mid in [(52, 0.82, False), (120, 1, True), (188, 0.82, False)] %}
  <g transform="translate({{ x }} 66) scale({{ s }})"{% if mid and sniff %} class="sniff"{% endif %}>
    <circle cx="-26" cy="-26" r="17" fill="currentColor" opacity=".9"/>
    <circle cx="26" cy="-26" r="17" fill="currentColor" opacity=".9"/>
    <circle cx="-26" cy="-26" r="9" fill="var(--panel)" opacity=".55"/>
    <circle cx="26" cy="-26" r="9" fill="var(--panel)" opacity=".55"/>
    <ellipse cx="0" cy="2" rx="34" ry="30" fill="currentColor"/>
    <rect x="-27" y="-9" width="22" height="13" rx="6" fill="var(--text)"/>
    <rect x="5" y="-9" width="22" height="13" rx="6" fill="var(--text)"/>
    <path d="M-5 -3h10" stroke="var(--text)" stroke-width="3"/>
    <circle cx="-20" cy="-5" r="2.2" fill="var(--panel)" opacity=".7"/>
    <circle cx="12" cy="-5" r="2.2" fill="var(--panel)" opacity=".7"/>
    <circle cx="0" cy="16" r="5" fill="var(--high)"/>
    <path d="M-8 18 L-34 12 M-8 21 L-34 24 M8 18 L34 12 M8 21 L34 24" stroke="var(--muted)" stroke-width="1.6" stroke-linecap="round"/>
  </g>
  {% endfor %}
</svg>
