<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}threeblindmice · dashboard{% endblock %}</title>
<style>
  :root {
    --bg: #f6f7f9; --panel: #fff; --text: #1b1f24; --muted: #5f6b7a; --line: #e3e7ec;
    --critical: #b4121b; --high: #d9480f; --medium: #c48a00; --low: #2f6fbf;
    --good: #2b8a3e; --accent: #5b3fd0; --band-good: rgba(43,138,62,.07); --band-bad: rgba(180,18,27,.06);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0f1216; --panel: #171b21; --text: #e6e9ee; --muted: #93a0b0; --line: #2a313b;
      --critical: #ff5c66; --high: #ff8a4c; --medium: #f2c14e; --low: #6ea8ff;
      --good: #51cf66; --accent: #9b87ff; --band-good: rgba(81,207,102,.08); --band-bad: rgba(255,92,102,.07);
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text);
         font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
  main { max-width: 1100px; margin: 0 auto; padding: 28px 16px 64px; }
  h1 { font-size: 24px; margin: 0 0 4px; } h2 { font-size: 17px; margin: 0 0 12px; }
  nav { margin: 6px 0 0; font-size: 14px; } nav a { margin-right: 14px; }
  .muted { color: var(--muted); } code { font-family: ui-monospace, Consolas, monospace; font-size: 12.5px; }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 14px; margin: 22px 0; }
  .card { background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 16px;
          cursor: pointer; transition: border-color .15s; }
  .card:hover, .card.active { border-color: var(--accent); }
  .card .top { display: flex; justify-content: space-between; align-items: baseline; }
  .card .grade { font-size: 30px; font-weight: 800; }
  .grade-A, .grade-B { color: var(--good); } .grade-C { color: var(--medium); }
  .grade-D { color: var(--high); } .grade-F { color: var(--critical); }
  .pills span { font-size: 12px; margin-right: 8px; }
  .c { color: var(--critical); } .h { color: var(--high); } .m { color: var(--medium); } .l { color: var(--low); }
  .spark polyline { fill: none; stroke: var(--accent); stroke-width: 2; }
  section { background: var(--panel); border: 1px solid var(--line); border-radius: 12px; padding: 20px; margin-bottom: 18px; }
  .chart { width: 100%; height: auto; }
  .chart .grid { stroke: var(--line); } .chart .axis { fill: var(--muted); font-size: 11px; }
  .chart .line { fill: none; stroke: var(--accent); stroke-width: 2.5; }
  .chart .dot { fill: var(--panel); stroke: var(--accent); stroke-width: 2; }
  .chart .band-good { fill: var(--band-good); } .chart .band-bad { fill: var(--band-bad); }
  table { width: 100%; border-collapse: collapse; font-size: 14px; }
  th, td { text-align: left; padding: 8px; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: .05em; }
  .table-wrap { overflow-x: auto; }
  a { color: var(--accent); } button.link { background: none; border: 0; color: var(--accent); cursor: pointer; padding: 0; font: inherit; }
  .diff-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; }
  .diff-grid div { border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; }
  .label { font-size: 12px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: .05em; }
  .tag { display: inline-block; font-size: 11px; padding: 1px 7px; border-radius: 999px; border: 1px solid var(--line); margin: 1px 3px 1px 0; }
  .loading { opacity: .6; }
  nav.gui { display: flex; gap: 6px; flex-wrap: wrap; margin: 14px 0 4px; }
  nav.gui a { margin: 0; padding: 7px 12px; border-radius: 8px; border: 1px solid var(--line);
              background: var(--panel); text-decoration: none; color: var(--text); font-weight: 600; }
  nav.gui a.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
  nav.gui a.here { border-color: var(--accent); }
  .btn { display: inline-block; padding: 8px 14px; border-radius: 8px; border: 1px solid var(--accent);
         background: var(--accent); color: #fff; font: inherit; font-weight: 600; cursor: pointer; }
  .btn.ghost { background: transparent; color: var(--accent); }
  .btn:disabled { opacity: .5; cursor: not-allowed; }
  input[type=text], input[type=date], select, textarea { font: inherit; padding: 7px 9px; border-radius: 8px;
         border: 1px solid var(--line); background: var(--bg); color: var(--text); }
  .hint { font-size: 13px; color: var(--muted); }
  .error { color: var(--critical); font-weight: 600; }
  .ok { color: var(--good); font-weight: 600; }
</style>
{% if gui %}<meta name="tbm-token" content="{{ csrf_token }}">
<script>
/* Ações da interface: o token vem desta página (outro site não consegue lê-lo). */
async function tbmPost(url, data) {
  const token = document.querySelector('meta[name="tbm-token"]').content;
  const r = await fetch(url, {method: "POST", headers: {"Content-Type": "application/json", "X-TBM-Token": token},
                              body: JSON.stringify(data)});
  const body = await r.json().catch(() => ({}));
  if (!r.ok) throw new Error(body.error || ("HTTP " + r.status));
  return body;
}
</script>{% endif %}
<script>
/* Carregador mínimo de fragmentos: substitui o HTMX para o dashboard funcionar
   sem internet. [data-get] busca a URL e coloca o HTML em [data-target]
   (ou no próprio elemento); data-trigger="load" carrega ao abrir a página. */
(function () {
  async function load(el) {
    const target = document.querySelector(el.dataset.target) || el;
    el.classList.add("loading");
    try {
      const r = await fetch(el.dataset.get);
      target.innerHTML = r.ok ? await r.text() : '<p class="muted">Erro ' + r.status + "</p>";
      init(target);
    } catch (e) {
      target.innerHTML = '<p class="muted">Falha ao carregar.</p>';
    } finally {
      el.classList.remove("loading");
    }
  }
  function init(root) {
    root.querySelectorAll('[data-get][data-trigger="load"]').forEach(load);
  }
  document.addEventListener("click", function (e) {
    const el = e.target.closest("[data-get]");
    if (el && el.dataset.trigger !== "load") { e.preventDefault(); load(el); }
  });
  document.addEventListener("DOMContentLoaded", function () { init(document); });
})();
</script>
</head>
<body>
<main>
  <h1>🐭🐭🐭 threeblindmice</h1>
  {% if gui %}
  <div class="muted">Interface local · v{{ version }}</div>
  <nav class="gui">
    <a href="/scan" class="primary">＋ Novo scan</a>
    <a href="/">Visão geral</a>
    <a href="/findings">Achados</a>
    <a href="/inventory">Dispositivos</a>
    <a href="/alerts">Alertas</a>
    <a href="/watch">Vigia</a>
    <a href="/features">Funcionalidades</a>
  </nav>
  <script>document.querySelectorAll("nav.gui a").forEach(a => { if (a.getAttribute("href") !== "/" ? location.pathname.startsWith(a.getAttribute("href")) : location.pathname === "/") a.classList.add("here"); });</script>
  {% else %}
  <div class="muted">Dashboard local · somente leitura · v{{ version }}</div>
  <nav><a href="/">Visão geral</a>{% for l in nav_labels %}<a href="/inventory/{{ l | urlencode }}">Dispositivos · {{ l }}</a>{% endfor %}</nav>
  {% endif %}
  {% block content %}{% endblock %}
</main>
</body>
</html>
